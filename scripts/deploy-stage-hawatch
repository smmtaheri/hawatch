#!/usr/bin/env bash
set -Eeuo pipefail

# Push and deploy only the optional stage checkout. Production is never pulled,
# rebuilt, restarted, or otherwise touched by this command.
LOCAL_DIR="${HAWATCH_LOCAL_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
SSH_HOST="${HAWATCH_SSH_HOST:-hawatch}"
STAGE_DIR="${HAWATCH_STAGE_DIR:-/root/hawatch-stage}"
STAGE_ENV="${HAWATCH_STAGE_ENV_FILE:-/root/hawatch-stage.env}"
LEGACY_STAGE_DIR="${HAWATCH_LEGACY_STAGE_DIR:-/root/hawatch-new-design}"

fail() { printf '[deploy-stage-hawatch] ERROR: %s\n' "$*" >&2; exit 1; }
[[ -n "$LOCAL_DIR" ]] || fail "Run from a Hawatch checkout or set HAWATCH_LOCAL_DIR."
[[ "$(git -C "$LOCAL_DIR" branch --show-current)" == stage ]] || fail "Run deploy-stage-hawatch from the local stage branch."
[[ "$(git -C "$LOCAL_DIR" remote get-url origin 2>/dev/null || true)" == git@github.com:smmtaheri/hawatch.git ]] || fail "Unexpected Git remote; refusing to deploy."
[[ "$SSH_HOST" =~ ^[A-Za-z0-9._-]+(@[A-Za-z0-9.-]+)?$ && "$SSH_HOST" != -* ]] || fail "Invalid SSH target."
for path in "$LOCAL_DIR" "$STAGE_DIR" "$STAGE_ENV" "$LEGACY_STAGE_DIR"; do
  [[ "$path" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail "Invalid path."
done

[[ -z "$(git -C "$LOCAL_DIR" status --porcelain)" ]] || fail "Local stage checkout is dirty; commit your work first."
[[ "$STAGE_DIR" != /root/hawatch && "$LEGACY_STAGE_DIR" != /root/hawatch && "$STAGE_ENV" != /root/hawatch/.env ]] || fail "Stage paths must be separate from production."

git -C "$LOCAL_DIR" push origin stage

ssh "$SSH_HOST" bash -s -- "$STAGE_DIR" "$STAGE_ENV" "$LEGACY_STAGE_DIR" <<'REMOTE'
set -Eeuo pipefail
stage_dir="$1"; stage_env="$2"; legacy_stage_dir="$3"
fail_remote() { printf '[deploy-stage-hawatch] ERROR: %s\n' "$*" >&2; exit 1; }
expected_remote='git@github.com:smmtaheri/hawatch.git'

remove_project() {
  local project="$1" ids reference
  ids="$(docker ps -aq --filter "label=com.docker.compose.project=${project}")"
  [[ -z "$ids" ]] || docker rm -f $ids >/dev/null
  ids="$(docker network ls -q --filter "label=com.docker.compose.project=${project}")"
  [[ -z "$ids" ]] || docker network rm $ids >/dev/null 2>&1 || true
  ids="$(docker volume ls -q --filter "label=com.docker.compose.project=${project}")"
  [[ -z "$ids" ]] || docker volume rm $ids >/dev/null 2>&1 || true
  while IFS= read -r reference; do
    [[ -z "$reference" ]] || docker image rm "$reference" >/dev/null 2>&1 || true
  done < <(docker image ls --format '{{.Repository}}:{{.Tag}}' | awk -F: -v prefix="$project" '$1 == prefix "-api" || $1 == prefix "-web" {print $0}')
}

# Generate independent stage secrets once; retain operator settings on later deploys.

if [[ ! -e "$stage_dir" && -d "$legacy_stage_dir" ]]; then
  [[ -z "$(git -C "$legacy_stage_dir" status --porcelain)" ]] || fail_remote 'Legacy stage checkout is dirty; inspect it manually.'
  [[ "$(git -C "$legacy_stage_dir" remote get-url origin)" =~ ^(git@github.com:smmtaheri/hawatch.git|https://github.com/smmtaheri/hawatch.git)$ ]] || fail_remote 'Unexpected legacy stage remote.'
  [[ "$(git -C "$legacy_stage_dir" branch --show-current)" == new-design || "$(git -C "$legacy_stage_dir" branch --show-current)" == stage ]] || fail_remote 'Legacy stage checkout must be on new-design or stage.'
  if [[ "$(git -C "$legacy_stage_dir" branch --show-current)" == new-design ]]; then
    git -C "$legacy_stage_dir" fetch origin refs/heads/stage:refs/remotes/origin/stage
    git -C "$legacy_stage_dir" branch -m new-design stage
    git -C "$legacy_stage_dir" branch --set-upstream-to=origin/stage stage
  fi
  mkdir -p "$(dirname "$stage_dir")"
  mv "$legacy_stage_dir" "$stage_dir"
fi

if [[ ! -e "$stage_dir" ]]; then
  git clone --branch stage --single-branch "$expected_remote" "$stage_dir"
fi
[[ "$(git -C "$stage_dir" branch --show-current)" == stage ]] || fail_remote 'Stage checkout must be on branch stage.'
[[ -z "$(git -C "$stage_dir" status --porcelain)" ]] || fail_remote 'Stage checkout is dirty; inspect it manually.'
[[ "$(git -C "$stage_dir" remote get-url origin)" =~ ^(git@github.com:smmtaheri/hawatch.git|https://github.com/smmtaheri/hawatch.git)$ ]] || fail_remote 'Unexpected stage remote.'
git -C "$stage_dir" pull --ff-only origin stage
python3 "$stage_dir/scripts/prepare-stage-env.py" "$stage_env"
stage_port="$(awk -F= '$1 == "HAWATCH_STAGE_PORT" {gsub(/[[:space:]\r]/, "", $2); print $2; exit}' "$stage_env")"
[[ "${stage_port:-5050}" == 5050 ]] || fail_remote "Stage must use port 5050."


# Build while the existing stage remains available. Replace it only after both
# application images are ready, then verify all three services and live data.
HAWATCH_STAGE_DIR="$stage_dir" HAWATCH_STAGE_ENV_FILE="$stage_env" bash "$stage_dir/scripts/deploy-stage.sh" prepare
remove_project hawatch-new-design
HAWATCH_STAGE_DIR="$stage_dir" HAWATCH_STAGE_ENV_FILE="$stage_env" bash "$stage_dir/scripts/deploy-stage.sh" activate
REMOTE
