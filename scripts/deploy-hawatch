#!/usr/bin/env bash
set -Eeuo pipefail

# Publish and deploy the production checkout only.
# The former stage stack is intentionally not part of this command anymore.
LOCAL_DIR="${HAWATCH_LOCAL_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
SSH_HOST="${HAWATCH_SSH_HOST:-hawatch}"
PRODUCTION_DIR="${HAWATCH_SERVER_DIR:-/root/hawatch}"
SERVER_IP="${HAWATCH_SERVER_IP:-202.133.89.120}"
PUBLIC_HOST="${HAWATCH_PUBLIC_HOST:-hawatch.ir}"
SERVER_API_URL="${HAWATCH_SERVER_API_URL:-/api/v1}"

fail() { printf '[deploy-hawatch] ERROR: %s\n' "$*" >&2; exit 1; }

[[ "$#" -eq 0 ]] || fail 'Usage: deploy-hawatch'
[[ -n "$LOCAL_DIR" ]] || fail 'Run this command from a Hawatch checkout or set HAWATCH_LOCAL_DIR.'
[[ "$LOCAL_DIR" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail 'Invalid local checkout path.'
[[ "$PRODUCTION_DIR" =~ ^/[A-Za-z0-9._/-]+$ ]] || fail 'Invalid production checkout path.'
[[ "$SSH_HOST" =~ ^[A-Za-z0-9._-]+(@[A-Za-z0-9.-]+)?$ && "$SSH_HOST" != -* ]] || fail 'Invalid SSH target.'
[[ "$SERVER_IP" =~ ^[A-Za-z0-9._-]+$ && "$SERVER_IP" != -* ]] || fail 'Invalid server host.'
[[ "$PUBLIC_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || fail 'Invalid public host.'
[[ "$SERVER_API_URL" =~ ^(/api/v1|https?://[A-Za-z0-9.-]+:[0-9]+/api/v1)$ ]] || fail 'Invalid server API URL.'
[[ "$(git -C "$LOCAL_DIR" branch --show-current)" == main ]] || fail 'Run deploy-hawatch from main.'
[[ "$(git -C "$LOCAL_DIR" remote get-url origin 2>/dev/null || true)" == git@github.com:smmtaheri/hawatch.git ]] || fail 'Unexpected local remote.'

if [[ -n "$(git -C "$LOCAL_DIR" status --porcelain)" ]]; then
  printf '[deploy-hawatch] WARNING: uncommitted local changes will not be staged, committed, or pushed.\n' >&2
fi

git -C "$LOCAL_DIR" push origin main

ssh "$SSH_HOST" bash -s -- "$PRODUCTION_DIR" "$PUBLIC_HOST" "$SERVER_IP" "$SERVER_API_URL" <<'REMOTE'
set -Eeuo pipefail
production_dir="$1"
public_host="$2"
server_ip="$3"
server_api_url="$4"

fail_remote() { printf '[deploy-hawatch] ERROR: %s\n' "$*" >&2; exit 1; }

[[ "$(git -C "$production_dir" branch --show-current)" == main ]] || fail_remote 'Production checkout must remain on main.'
[[ "$(git -C "$production_dir" remote get-url origin 2>/dev/null || true)" =~ ^(git@github.com:smmtaheri/hawatch.git|https://github.com/smmtaheri/hawatch.git)$ ]] || fail_remote 'Unexpected production remote.'
[[ -z "$(git -C "$production_dir" status --porcelain)" ]] || fail_remote 'Production checkout is dirty; inspect it manually.'

git -C "$production_dir" pull --ff-only origin main
cd "$production_dir"
PUBLIC_HOST="$public_host" \
VITE_API_BASE_URL="$server_api_url" \
DJANGO_ALLOWED_HOSTS="$public_host,www.$public_host,$server_ip,localhost,127.0.0.1,api,nginx" \
DJANGO_CORS_ALLOWED_ORIGINS="http://$public_host,https://$public_host,http://www.$public_host,https://www.$public_host,http://$server_ip,http://$server_ip:5173" \
RUN_INITIAL_INGEST=0 ./scripts/deploy.sh </dev/null
REMOTE
