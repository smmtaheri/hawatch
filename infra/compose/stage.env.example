HAWATCH_STAGE_ENABLED=1
HAWATCH_STAGE_ENV_FILE=/root/hawatch-stage.env
HAWATCH_STAGE_ALLOWED_HOSTS=SERVER_IP_OR_DOMAIN
HAWATCH_STAGE_ORIGIN=http://SERVER_IP_OR_DOMAIN:5050
HAWATCH_STAGE_PORT=5050
HAWATCH_STAGE_BIND_IP=0.0.0.0
HAWATCH_PUBLIC_ORIGIN=https://hawatch.ir
POSTGRES_DB=hawatch_stage
POSTGRES_USER=hawatch_stage
POSTGRES_HOST=stage-postgres
POSTGRES_PASSWORD=GENERATE_A_SEPARATE_SECRET
DJANGO_SECRET_KEY=GENERATE_A_SEPARATE_SECRET
HAWATCH_ENVIRONMENT=stage
DEMO_DATA_ENABLED=false
HAWATCH_BOOTSTRAP_LIVE_CATALOG_IF_EMPTY=false
OPEN_METEO_FORECAST_DAYS=10
