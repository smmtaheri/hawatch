# Operator-owned file outside either checkout. Set enabled to 0 to stop and
# remove stage containers, network, log volume and local images on next deploy.
HAWATCH_STAGE_ENABLED=1
HAWATCH_PRODUCTION_ENV_FILE=/root/hawatch/.env
HAWATCH_PRODUCTION_NETWORK=hawatch_default
HAWATCH_PRODUCTION_DB_HOST=postgres
HAWATCH_STAGE_ALLOWED_HOSTS=SERVER_IP_OR_DOMAIN
HAWATCH_STAGE_ORIGIN=http://SERVER_IP_OR_DOMAIN:5050
HAWATCH_STAGE_BIND_IP=0.0.0.0
HAWATCH_STAGE_PORT=5050
HAWATCH_PUBLIC_ORIGIN=https://hawatch.ir
