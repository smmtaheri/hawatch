# هواچ — local development. Copy to `.env` and keep real secrets out of git.

# Django
DJANGO_SETTINGS_MODULE=hawatch.config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Time
HAWATCH_TIMEZONE=Asia/Tehran

# PostgreSQL / PostGIS
POSTGRES_DB=hawatch
POSTGRES_USER=hawatch
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PostgreSQL is internal-only in Compose; POSTGRES_PORT is the container port.

# Demo weather (disable when real ingestion is added later)
DEMO_DATA_ENABLED=true
DEMO_SEED_VERSION=hawatch-demo-v1

# Frontend (browser calls the published API port)
VITE_API_BASE_URL=http://localhost:8000/api/v1
API_PUBLISH_PORT=8000
WEB_PUBLISH_PORT=5173

# Internal Redis remains redis:6379 and is optional (profile: cache).
REDIS_URL=redis://localhost:6379/0
WEATHER_PROXY_URL=

# Open-Meteo ingestion (management command only; API handlers never call the provider)
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_BATCH_SIZE=100
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_PAST_DAYS=1
FORECAST_STALE_AFTER_HOURS=3

# Live catalog/ingestion
HAWATCH_LIVE_SEED_VERSION=hawatch-tochal-catalog-v1
LIVE_INGEST_INTERVAL_SECONDS=1800

# Observability. Replace every placeholder with a generated secret; never commit .env.
HAWATCH_ENVIRONMENT=local
HAWATCH_RETENTION_DAYS=7
HAWATCH_METRICS_TOKEN=replace-with-at-least-32-random-bytes
OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-opensearch-password
OPENSEARCH_DASHBOARDS_SERVICE_USER=hawatch-dashboards
OPENSEARCH_DASHBOARDS_SERVICE_PASSWORD=replace-with-a-strong-dashboards-service-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
OPENSEARCH_DASHBOARDS_PUBLISH_PORT=5601
GRAFANA_PUBLISH_PORT=3000
GRAFANA_ROOT_URL=http://localhost:3000
RETENTION_INTERVAL_SECONDS=86400
