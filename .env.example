# هواچ — local development. Copy to `.env` and keep real secrets out of git.

# Django
DJANGO_SETTINGS_MODULE=hawatch.config.settings.local
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Time
HAWATCH_TIMEZONE=Asia/Tehran

# PostgreSQL / PostGIS
POSTGRES_DB=hawatch
POSTGRES_USER=hawatch
POSTGRES_PASSWORD=hawatch
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If host 5432 is already taken, set POSTGRES_PUBLISH_PORT=5433 when running Compose.
POSTGRES_PUBLISH_PORT=5432

# Demo weather (disable when real ingestion is added later)
DEMO_DATA_ENABLED=true
DEMO_SEED_VERSION=hawatch-demo-v1

# Frontend (browser calls the published API port)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Future placeholders — unused in this milestone
# Internal Redis remains redis:6379. If host 6379 is taken, set REDIS_PUBLISH_PORT=6380.
REDIS_PUBLISH_PORT=6379
REDIS_URL=redis://localhost:6379/0
WEATHER_PROXY_URL=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
